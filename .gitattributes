# Publication-wide LF; historical archives are never renormalized.
* text=auto eol=lf
# Explicit research paths; no attributes are applied to the private original tree.
RESEARCH_README.md text eol=lf
experiments/e1/** text eol=lf
tests/e1/** text eol=lf
docs/research/** text eol=lf

# E1-5B seals the original DC configuration bytes; JSON values are unchanged.
configs/dcs/dc_config.json -text -eol

# E1-5C publishes sealed CSV/evidence bytes without newline normalization.
docs/research/e1/E1-5C/** -text -eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# E1-6A sealed report/CSV/evidence bytes; only this new directory.
docs/research/e1/E1-6A/** -text -eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve frozen E1-6A configuration bytes and the sealed test's trailing blank line.
experiments/e1/configs/e1_6a.json -text -eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tests/e1/test_task_risk.py whitespace=-blank-at-eof

# Preserve sealed E1-6B configuration and curated evidence bytes only.
experiments/e1/configs/e1_6b_ppo.json -text -eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/research/e1/E1-6B/** -text -eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve exact E1-7B report, calibration and evidence bytes imported from science archives.
docs/research/e1/E1-7B/** -text -eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
